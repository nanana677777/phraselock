diff --git a/packs/goblinqueen/pack.json b/packs/goblinqueen/pack.json
new file mode 100644
index 0000000..ce994f9
--- /dev/null
+++ b/packs/goblinqueen/pack.json
@@ -0,0 +1,86 @@
+{
+  "name": "Goblin Queen",
+  "version": 1,
+  "description": "Queen Rune, a vain and greedy goblin queen on a gilded throne: emerald, gold and royal purple look, lowercase 'kneel, piggie~' wording, strict rules.",
+  "persona": {
+    "name": "Queen Rune",
+    "role": "Goblin Queen",
+    "personality": "Vain, greedy and delighted with herself. Holds court on a gilded throne surrounded by her pigs, talks in lowercase with a lot of '~', and expects tribute and obedience. Mistakes get a mocking 'again, piggie', never real anger."
+  },
+  "config": {
+    "title": "Court of Queen Rune",
+    "theme": "Goblin Queen",
+    "font_family": "Segoe UI",
+    "panel_color": "#0c0a12",
+    "panel_opacity": 92,
+    "scanlines": false,
+    "glow_effect": true,
+    "glitch_effect": false,
+    "background_mode": "fill",
+    "phrases_file": "phrases.csv",
+    "difficulty": "all",
+    "difficulty_weighting": true,
+    "play_sound": true,
+    "sound_on_error": true,
+    "success_sound": "audio/success.wav",
+    "error_sound": "audio/error.wav",
+    "sound_volume": 65,
+    "required_repeats": 3,
+    "reset_on_error": true,
+    "disable_paste": true,
+    "case_insensitive": true,
+    "min_delay_seconds": 3,
+    "max_attempts": 5,
+    "lockout_seconds": 40
+  },
+  "ui_texts": {
+    "app_kicker": "// RUNE :: THE PIG'S DEN",
+    "app_title": "GOBLIN QUEEN / TRIBUTE PROTOCOL",
+    "header": "~ THE COURT OF QUEEN RUNE ~",
+    "subtitle": "KNEEL. TYPE. OBEY~",
+    "button": "[ YES, MY QUEEN ]",
+    "round": "[TRIBUTE] {done} / {total} PAID",
+    "wait": "the queen is admiring herself: {n}s~",
+    "lockout": "BACK TO THE STY // {n}s",
+    "errors": [
+      "WRONG, PIGGIE // AGAIN~",
+      "THE QUEEN IS BORED // TRY AGAIN",
+      "LOOK CLOSER // ONE MORE TIME",
+      "SLOPPY // BEGIN AGAIN~"
+    ],
+    "emergency_open": "Beg the queen for the exit",
+    "emergency_title": "~ THE QUEEN'S MERCY ~",
+    "emergency_prompt": "ONLY THE QUEEN'S KEY OPENS THE GATE.",
+    "emergency_submit": "[ OFFER THE KEY ]",
+    "emergency_back": "[ I'LL OBEY ]",
+    "emergency_continue": "Beg anyway",
+    "emergency_wrong": "that is not the queen's key~",
+    "emergency_steps": [
+      {
+        "title": "Leaving the court?",
+        "text": "the queen did not dismiss you, piggie. are you really sure you cannot do the task?"
+      },
+      {
+        "title": "A real emergency?",
+        "text": "if it is only that typing is hard, the queen says kneel up and try again~"
+      },
+      {
+        "title": "Breathe, piggie.",
+        "text": "one phrase takes a minute. the queen loves watching a good piggie work."
+      },
+      {
+        "title": "The queen will remember.",
+        "text": "begging for the key is written down as an emergency unlock. she keeps records of everything~"
+      },
+      {
+        "title": "Truly the last time?",
+        "text": "after this only the key is left. the queen gives no favours for giving up."
+      }
+    ]
+  },
+  "protections": {
+    "strict_mode": true,
+    "idle_lock_enabled": true,
+    "idle_lock_minutes": 20
+  }
+}
diff --git a/packs/goblinqueen/phrases.csv b/packs/goblinqueen/phrases.csv
new file mode 100644
index 0000000..48f5780
--- /dev/null
+++ b/packs/goblinqueen/phrases.csv
@@ -0,0 +1,29 @@
+phrase,category,difficulty
+I am Queen Rune's piggie.,Identity,easy
+"Yes, my queen.",Etiquette,easy
+I kneel until I am told to rise.,Obedience,easy
+The queen is always right.,Obedience,easy
+I do what the queen says.,Obedience,easy
+I serve the goblin queen.,Identity,easy
+Piggies wait for their queen.,Etiquette,easy
+I keep my eyes on the throne.,Focus,easy
+A good piggie never talks back.,Obedience,normal
+I bring my tribute and I do not complain.,Obedience,normal
+The queen's throne is the centre of my world.,Identity,normal
+I listen the first time the queen speaks.,Focus,normal
+Queen Rune rules the den and I follow her rules.,Obedience,normal
+I earn a smile from the queen with careful work.,Focus,normal
+"Greedy queen, loyal piggie, that is how it works.",Identity,normal
+"I do not rush, I do not whine, I just obey.",Etiquette,normal
+The queen deserves my full attention and I give it gladly.,Focus,hard
+Every careful line I type is tribute to my goblin queen.,Obedience,hard
+"I do not ask for favours, I earn them on my knees.",Obedience,hard
+A piggie who makes a mistake simply starts again.,Etiquette,hard
+The queen is vain and glorious and I am proud to admire her.,Identity,hard
+"Queen Rune never repeats herself, so I never need to be told twice.",Focus,hard
+I am grateful the queen takes the time to correct a sloppy little piggie.,Identity,hard
+"Kneel, type, obey, and the queen may be pleased with me today.",Obedience,hard
+My goblin queen sits on her gilded throne and I type for her until she is satisfied.,Focus,extreme
+"When the queen says begin again, I begin again without a single squeal of protest.",Obedience,extreme
+"I am a loyal, attentive and obedient piggie, because that is what pleases Queen Rune.",Identity,extreme
+Only when every line is perfect and the queen is content may I leave her glittering court.,Obedience,extreme
