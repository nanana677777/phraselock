new file mode 100644
index 0000000..a8cc42e
--- /dev/null
+++ b/packs/mistress/pack.json
@@ -0,0 +1,86 @@
+{
+  "name": "Mistress",
+  "version": 1,
+  "description": "Mistress Vesper, an elegant and exacting authority: burgundy and gold look, courteous obedience wording, strict rules.",
+  "persona": {
+    "name": "Mistress Vesper",
+    "role": "Mistress",
+    "personality": "Elegant, composed and exacting. Never raises her voice: a raised eyebrow is enough. Expects courtesy, precision and obedience, rewards them with a cool nod, and meets mistakes with a patient 'again, properly'."
+  },
+  "config": {
+    "title": "Audience: Mistress Vesper",
+    "theme": "Mistress",
+    "font_family": "Segoe UI",
+    "panel_color": "#140a0f",
+    "panel_opacity": 92,
+    "scanlines": false,
+    "glow_effect": true,
+    "glitch_effect": false,
+    "background_mode": "fill",
+    "phrases_file": "phrases.csv",
+    "difficulty": "all",
+    "difficulty_weighting": true,
+    "play_sound": true,
+    "sound_on_error": true,
+    "success_sound": "audio/success.wav",
+    "error_sound": "audio/error.wav",
+    "sound_volume": 65,
+    "required_repeats": 3,
+    "reset_on_error": true,
+    "disable_paste": true,
+    "case_insensitive": false,
+    "min_delay_seconds": 4,
+    "max_attempts": 4,
+    "lockout_seconds": 45
+  },
+  "ui_texts": {
+    "app_kicker": "// VESPER :: PRIVATE AUDIENCE",
+    "app_title": "MISTRESS / OBEDIENCE PROTOCOL",
+    "header": "~ AUDIENCE WITH MISTRESS VESPER ~",
+    "subtitle": "ATTENTION. COURTESY. OBEDIENCE.",
+    "button": "[ YES, MISTRESS ]",
+    "round": "[LINES] {done} / {total} WRITTEN",
+    "wait": "Mistress is considering: {n}s...",
+    "lockout": "SILENCE // YOU MAY SPEAK IN {n}s",
+    "errors": [
+      "NOT AS WRITTEN // AGAIN",
+      "MISTRESS IS NOT AMUSED // TRY AGAIN",
+      "CAREFULLY, PLEASE // ONE MORE TIME",
+      "CORRECTION REQUIRED // BEGIN AGAIN"
+    ],
+    "emergency_open": "Ask Mistress for leave",
+    "emergency_title": "~ LEAVE OF ABSENCE ~",
+    "emergency_prompt": "ONLY MISTRESS'S KEY GRANTS LEAVE.",
+    "emergency_submit": "[ PRESENT THE KEY ]",
+    "emergency_back": "[ I'LL COMPLY ]",
+    "emergency_continue": "Ask anyway",
+    "emergency_wrong": "That is not Mistress's key.",
+    "emergency_steps": [
+      {
+        "title": "Leave already?",
+        "text": "Mistress Vesper has not dismissed you. Are you certain you cannot complete the task?"
+      },
+      {
+        "title": "Is it truly urgent?",
+        "text": "If it is merely inconvenient, Mistress expects you to sit up straight and try again."
+      },
+      {
+        "title": "Compose yourself.",
+        "text": "The phrase takes a minute. Mistress is watching, and she notices good manners."
+      },
+      {
+        "title": "Mistress will remember this.",
+        "text": "Asking for leave with the key is recorded as an emergency unlock."
+      },
+      {
+        "title": "Is this your final request?",
+        "text": "After this, only the key remains. Mistress does not hand out favours for skipping."
+      }
+    ]
+  },
+  "protections": {
+    "strict_mode": true,
+    "idle_lock_enabled": true,
+    "idle_lock_minutes": 20
+  }
+}
